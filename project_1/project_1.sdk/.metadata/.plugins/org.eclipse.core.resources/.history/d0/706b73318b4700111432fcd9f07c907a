#ifndef GRU_Q
#define GRU_Q 12
#endif
#ifndef GRU_ONE
#define GRU_ONE (1 << GRU_Q)
#endif

static inline int clamp_int(int x, int lo, int hi)
{
    if (x < lo) return lo;
    if (x > hi) return hi;
    return x;
}

// Q12 sigmoid approximation.
// Input : Q12
// Output: Q12, range 0 ~ 4096
static inline int sigmoid_q12_fast(int x)
{
    const int Q_0P05 = 205;          // round(0.05 * 4096)
    const int Q_0P20 = 819;          // round(0.20 * 4096)
    const int Q_0P50 = GRU_ONE >> 1; // 0.5
    const int Q_0P80 = 3277;         // round(0.80 * 4096)

    if (x <= -(4 * GRU_ONE)) return 0;
    if (x >=  (4 * GRU_ONE)) return GRU_ONE;

    int y;
    if (x < -GRU_ONE) {
        y = ((x * Q_0P05) >> GRU_Q) + Q_0P20;
    } else if (x < GRU_ONE) {
        y = (x >> 2) + Q_0P50;
    } else {
        y = ((x * Q_0P05) >> GRU_Q) + Q_0P80;
    }
    return clamp_int(y, 0, GRU_ONE);
}

// Q12 tanh approximation.
// Input : Q12
// Output: Q12, range -4096 ~ 4096
static inline int tanh_q12_fast(int x)
{
    if (x <= -(3 * GRU_ONE)) return -GRU_ONE;
    if (x >=  (3 * GRU_ONE)) return  GRU_ONE;

    int y;
    if (x < -GRU_ONE) {
        y = (x >> 2) - (GRU_ONE >> 2);
    } else if (x < GRU_ONE) {
        y = x;
    } else {
        y = (x >> 2) + (GRU_ONE >> 2);
    }
    return clamp_int(y, -GRU_ONE, GRU_ONE);
}

static int argmax5_int(const int logits[NUM_CLASSES])
{
    int best = 0;
    int m = logits[0];
    for (int i = 1; i < NUM_CLASSES; ++i) {
        if (logits[i] > m) {
            m = logits[i];
            best = i;
        }
    }
    return best;
}

// Fixed-point GRU, all arrays are int Q12.
// MAC policy requested here:
//   Do NOT shift each product during dot product accumulation.
//   Accumulate raw Q12*Q12 products as Q24, then shift once before activation/output.
static void ecg_gru(const int *x256, int out_logits[NUM_CLASSES])
{
    int h[GRU_H] = {0};

    for (int t = 0; t < T; ++t) {
        int z[GRU_H];
        int r[GRU_H];
        int h_tilde[GRU_H];
        const int *xt = x256 + t * IN;

        // 1) gates z and r
        for (int u = 0; u < GRU_H; ++u) {
            // bias is Q12. Shift left so it is aligned with raw MAC Q24.
            int zpre = gru_bias_q12[u] << GRU_Q;
            int rpre = gru_bias_q12[GRU_H + u] << GRU_Q;

            for (int k = 0; k < IN; ++k) {
                int xv = xt[k];
                zpre += xv * gru_kernel_q12[k][u];
                rpre += xv * gru_kernel_q12[k][GRU_H + u];
            }

            int hz = 0;
            int hr = 0;
            for (int k = 0; k < GRU_H; ++k) {
                int hv = h[k];
                hz += hv * gru_recurrent_kernel_q12[k][u];
                hr += hv * gru_recurrent_kernel_q12[k][GRU_H + u];
            }

            // Convert Q24 accumulator back to Q12 once, right before activation.
            z[u] = sigmoid_q12_fast((zpre + hz) >> GRU_Q);
            r[u] = sigmoid_q12_fast((rpre + hr) >> GRU_Q);
        }

        // 2) candidate h_tilde
        for (int u = 0; u < GRU_H; ++u) {
            int hpre = gru_bias_q12[2 * GRU_H + u] << GRU_Q;

            for (int k = 0; k < IN; ++k) {
                int xv = xt[k];
                hpre += xv * gru_kernel_q12[k][2 * GRU_H + u];
            }

            int hh = 0;
            for (int k = 0; k < GRU_H; ++k) {
                // r and h are Q12, so r*h is converted back to Q12 before U_h MAC.
                int rh = (r[k] * h[k]) >> GRU_Q;
                hh += rh * gru_recurrent_kernel_q12[k][2 * GRU_H + u];
            }

            h_tilde[u] = tanh_q12_fast((hpre + hh) >> GRU_Q);
        }

        // 3) update h. Formula follows the original code:
        // h = z * h_old + (1 - z) * h_tilde
        for (int u = 0; u < GRU_H; ++u) {
            int one_minus_z = GRU_ONE - z[u];
            h[u] = ((z[u] * h[u]) + (one_minus_z * h_tilde[u])) >> GRU_Q;
        }
    }

    // Dense(128->5). No softmax is needed for argmax.
    for (int j = 0; j < NUM_CLASSES; ++j) {
        int acc = gru_dense_b_q12[j] << GRU_Q;
        for (int i = 0; i < GRU_H; ++i) {
            acc += h[i] * gru_dense_W_q12[i][j];
        }
        out_logits[j] = acc >> GRU_Q;
    }
}

