//partial gru
#define GRU_U_CHUNK 4

typedef enum {
    GRU_PHASE_ZR = 0,
    GRU_PHASE_HTILDE,
    GRU_PHASE_UPDATE,
    GRU_PHASE_DENSE,
    GRU_PHASE_DONE
} GruPhase;

typedef struct {
    const float *x;
    int yt;

    int t;
    int u;
    int j;

    GruPhase phase;

    float h[GRU_H];
    float z[GRU_H];
    float r[GRU_H];
    float h_tilde[GRU_H];
    float logits[NUM_CLASSES];

    int pred;
    int done;
} GruTask;

static void gru_task_init(GruTask *g, const float *x, int yt)
{
    g->x = x;
    g->yt = yt;

    g->t = 0;
    g->u = 0;
    g->j = 0;

    g->phase = GRU_PHASE_ZR;
    g->pred = 0;
    g->done = 0;

    for (int i = 0; i < GRU_H; ++i) {
        g->h[i] = 0.0f;
        g->z[i] = 0.0f;
        g->r[i] = 0.0f;
        g->h_tilde[i] = 0.0f;
    }

    for (int i = 0; i < NUM_CLASSES; ++i) {
        g->logits[i] = 0.0f;
    }
}


static int gru_task_step(GruTask *g)
{
    if (g->done) return 1;

    if (g->phase == GRU_PHASE_ZR) {

        int u_end = g->u + GRU_U_CHUNK;
        if (u_end > GRU_H) u_end = GRU_H;

        const float *xt = g->x + g->t * IN;

        for (int u = g->u; u < u_end; ++u) {
            float zpre = gru_bias[u];
            float rpre = gru_bias[GRU_H + u];

            for (int k = 0; k < IN; ++k) {
                float xv = xt[k];
                zpre += xv * gru_kernel[k][u];
                rpre += xv * gru_kernel[k][GRU_H + u];
            }

            float hz = 0.0f;
            float hr = 0.0f;

            for (int k = 0; k < GRU_H; ++k) {
                float hv = g->h[k];
                hz += hv * gru_recurrent_kernel[k][u];
                hr += hv * gru_recurrent_kernel[k][GRU_H + u];
            }

            g->z[u] = sigmoidf_approx_fast(zpre + hz);
            g->r[u] = sigmoidf_approx_fast(rpre + hr);
        }

        g->u = u_end;

        if (g->u >= GRU_H) {
            g->u = 0;
            g->phase = GRU_PHASE_HTILDE;
        }

        return 0;
    }

    else if (g->phase == GRU_PHASE_HTILDE) {

        int u_end = g->u + GRU_U_CHUNK;
        if (u_end > GRU_H) u_end = GRU_H;

        const float *xt = g->x + g->t * IN;

        for (int u = g->u; u < u_end; ++u) {
            float hpre = gru_bias[2 * GRU_H + u];

            for (int k = 0; k < IN; ++k) {
                float xv = xt[k];
                hpre += xv * gru_kernel[k][2 * GRU_H + u];
            }

            float hh = 0.0f;

            for (int k = 0; k < GRU_H; ++k) {
                float hv = g->h[k] * g->r[k];
                hh += hv * gru_recurrent_kernel[k][2 * GRU_H + u];
            }

            g->h_tilde[u] = tanhf_approx_fast(hpre + hh);
        }

        g->u = u_end;

        if (g->u >= GRU_H) {
            g->u = 0;
            g->phase = GRU_PHASE_UPDATE;
        }

        return 0;
    }

    else if (g->phase == GRU_PHASE_UPDATE) {

        int u_end = g->u + GRU_U_CHUNK;
        if (u_end > GRU_H) u_end = GRU_H;

        for (int u = g->u; u < u_end; ++u) {
            float zu = g->z[u];
            g->h[u] = zu * g->h[u] + (1.0f - zu) * g->h_tilde[u];
        }

        g->u = u_end;

        if (g->u >= GRU_H) {
            g->u = 0;
            g->t++;

            if (g->t >= T) {
                g->phase = GRU_PHASE_DENSE;
                g->j = 0;
            } else {
                g->phase = GRU_PHASE_ZR;
            }
        }

        return 0;
    }

    else if (g->phase == GRU_PHASE_DENSE) {

        if (g->j < NUM_CLASSES) {
            float acc = gru_dense_b[g->j];

            for (int i = 0; i < GRU_H; ++i) {
                acc += g->h[i] * gru_dense_W[i][g->j];
            }

            g->logits[g->j] = acc;
            g->j++;

            return 0;
        }

        g->pred = argmax5(g->logits);
        g->done = 1;
        g->phase = GRU_PHASE_DONE;

        return 1;
    }

    return g->done;
}

